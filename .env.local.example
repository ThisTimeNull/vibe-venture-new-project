# Supabase 프로젝트 설정 (https://supabase.com 에서 프로젝트 생성 후 Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 사이트 URL (로컬 개발 시 기본값 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 개발 서버에서 Mock Provider 사용 여부
# - 기본값: 개발 모드에서 ON (값이 없으면 ON)
# - "off"로 설정하면 Supabase 실데이터 모드로 동작
BLOG_MOCK_MODE=on
